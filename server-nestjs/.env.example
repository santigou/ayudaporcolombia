# Database
DATABASE_URL="postgresql://ayuda:ayuda@localhost:5434/ayudaporcolombia?schema=public"

# Application
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# JWT
JWT_SECRET="your-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Seed Data
SEED_MODERATOR_NAME="Admin Moderator"
SEED_MODERATOR_EMAIL="moderator@ayudaporcolombia.co"
SEED_MODERATOR_PASSWORD="Admin123!"

# Storage (subida directa de fotos)
# local = disco (dev) | seaweedfs = SeaweedFS vía API S3 (prod)
STORAGE_DRIVER=local
# --- Solo con STORAGE_DRIVER=seaweedfs ---
# Endpoint de la API S3 (interno o público). SeaweedFS usa path-style.
S3_ENDPOINT=https://cdn.jffsolutions.com
S3_REGION=us-east-1
# Bucket (carpeta /buckets/<nombre> en el volumen de SeaweedFS)
S3_BUCKET=ayudaporcolombia
# Credenciales de la identidad creada en s3.json (ver docs/seaweedfs-s3-config.md)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# URL pública para leer las fotos (la que va en el <img>)
S3_PUBLIC_URL=https://cdn.jffsolutions.com