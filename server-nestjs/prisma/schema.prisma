generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  moderator
}

enum PointType {
  need_help
  offer_help
}

enum PointStatus {
  pending
  active
  resolved
  rejected
  expired
  cancelled
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum PointLocationType {
  location
  origin
  destination
}

enum ContactType {
  phone
  whatsapp
  instagram
  email
  other
}

enum AttachmentType {
  image
  video
  document
}

enum ValidationStatus {
  confirmed
  rejected
}

// CategorÃ­a (kind) de una novedad del timeline. Facilita la coordinaciÃ³n en el
// chat en tiempo real: distingue un comentario normal de "estoy ayudando",
// "terminamos", informaciÃ³n importante o algo urgente. El default `message`
// mantiene las novedades existentes como comentarios normales.
enum UpdateKind {
  message
  helping
  done
  important
  urgent
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role     @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  points            Point[]          @relation("PointCreatedBy")
  validations       Validation[]
  verifications     Verification[]   @relation("VerificationModerator")
  pointUpdates      PointUpdate[]
  moderatorRequests ModeratorRequest[] @relation("RequestByUser")
  reviewedRequests  ModeratorRequest[] @relation("RequestReviewedBy")
  statusRequests         PointStatusRequest[] @relation("StatusRequestByUser")
  reviewedStatusRequests PointStatusRequest[] @relation("StatusRequestReviewedBy")
  statusHistoryActor     PointStatusHistory[] @relation("StatusHistoryActor")
}

model ModeratorRequest {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @unique @db.Uuid
  status       VerificationStatus     @default(pending)
  reviewedById String?                @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime               @default(now())

  user       User  @relation("RequestByUser", fields: [userId], references: [id])
  reviewedBy User? @relation("RequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
}

model Point {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique
  type               PointType
  title              String
  description        String
  helpTypeId         String?            @db.Uuid
  status             PointStatus        @default(pending)
  verificationStatus VerificationStatus @default(pending)
  validationCount    Int                @default(0)

  createdById String? @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime?

  createdBy User? @relation("PointCreatedBy", fields: [createdById], references: [id])

  helpType      HelpType?        @relation(fields: [helpTypeId], references: [id])
  locations     PointLocation[]
  supplies      PointSupply[]
  contacts      Contact[]
  validations   Validation[]
  verifications Verification[]
  updates       PointUpdate[]
  attachments   Attachment[]
  statusRequests   PointStatusRequest[]
  statusHistory    PointStatusHistory[]
  partnerLinks     PartnerPointLink[]
  partnerSyncLogs  PartnerSyncLog[]

  @@index([type, status])
  @@index([verificationStatus])
  @@index([helpTypeId])
  @@index([createdAt])
  @@index([code])
  @@index([validationCount])
}

model HelpType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String

  points Point[]
}

model Location {
  id           String   @id @default(uuid()) @db.Uuid
  city         String
  neighborhood String
  address      String?
  latitude     Float
  longitude    Float

  points PointLocation[]
}

model PointLocation {
  pointId      String           @db.Uuid
  locationId   String           @db.Uuid
  locationType PointLocationType

  point    Point    @relation(fields: [pointId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([pointId, locationId, locationType])
  @@index([locationId])
  @@index([locationType])
}

model Supply {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  points PointSupply[]
}

model PointSupply {
  pointId          String  @db.Uuid
  supplyId         String  @db.Uuid
  targetQuantity   Decimal?
  receivedQuantity Decimal?
  unit             String?

  point  Point  @relation(fields: [pointId], references: [id], onDelete: Cascade)
  supply Supply @relation(fields: [supplyId], references: [id])

  @@id([pointId, supplyId])
}

model Contact {
  id        String      @id @default(uuid()) @db.Uuid
  pointId   String      @db.Uuid
  type      ContactType
  value     String
  isPublic  Boolean     @default(true)

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}

model Validation {
  pointId   String           @db.Uuid
  userId    String           @db.Uuid
  status    ValidationStatus @default(confirmed)
  createdAt DateTime         @default(now())

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pointId, userId])
  @@index([status])
}

model Verification {
  id          String             @id @default(uuid()) @db.Uuid
  pointId     String             @db.Uuid
  moderatorId String             @db.Uuid
  status      VerificationStatus
  note        String?
  createdAt   DateTime           @default(now())

  point     Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  moderator User  @relation("VerificationModerator", fields: [moderatorId], references: [id])

  @@index([pointId, createdAt])
  @@index([moderatorId])
}

model PointUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  pointId     String   @db.Uuid
  createdById String   @db.Uuid
  message     String
  kind        UpdateKind @default(message)
  createdAt DateTime @default(now())

  point     Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([pointId, createdAt])
}

model Attachment {
  id        String         @id @default(uuid()) @db.Uuid
  pointId   String         @db.Uuid
  url       String
  type      AttachmentType
  createdAt DateTime       @default(now())

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}

// Solicitud de cambio de estado de un Punto (ciclo de vida) hecha por un usuario
// que NO es el creador ni moderador. El usuario propone un estado objetivo
// (resolved/cancelled) + motivo; queda pendiente hasta que un moderador la aprueba
// (aplica el cambio) o rechaza. Una PENDIENTE por (usuario, punto): el constraint
// parcial UNIQUE se define en la migraciÃ³n (WHERE status = 'pending').
model PointStatusRequest {
  id            String             @id @default(uuid()) @db.Uuid
  pointId       String             @db.Uuid
  userId        String             @db.Uuid
  targetStatus  PointStatus
  reason        String?
  status        VerificationStatus @default(pending)
  reviewedById  String?            @db.Uuid
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())

  point      Point  @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user       User   @relation("StatusRequestByUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("StatusRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([pointId])
  @@index([status])
  @@index([userId])
}

// Historial de cambios de estado (ciclo de vida) de un Punto: una fila por cada
// transiciÃ³n APLICADA (directa por creador/moderador, o por solicitud aprobada).
// Registra deâ†’a, quiÃ©n la aplicÃ³, el motivo y, si vino de una solicitud aprobada,
// el enlace a esa solicitud. Es la fuente del tab "Estado" del detalle.
model PointStatusHistory {
  id            String     @id @default(uuid()) @db.Uuid
  pointId       String     @db.Uuid
  fromStatus    PointStatus
  toStatus      PointStatus
  reason        String?
  actorId       String     @db.Uuid
  requestId     String?    @db.Uuid
  createdAt     DateTime   @default(now())

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  actor User @relation("StatusHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([pointId, createdAt])
  @@index([actorId])
}

// ============================================================================
// Integraciones con apps partner (federaciÃ³n de puntos de ayuda)
//
// Permite que otras apps de ayuda nos envÃ­en puntos (inbound, vÃ­a API key) y
// que nosotros les enviemos los nuestros (outbound, estilo webhook), con
// conversiÃ³n de modelos por partner (mappers) y sincronizaciÃ³n idempotente.
// ============================================================================

// CÃ³mo se autentica NUESTRO backend ante un partner cuando le enviamos puntos
// (webhook outbound): API key estÃ¡tica o login user/password â†’ token Bearer.
enum PartnerAuthType {
  api_key
  login
}

// DirecciÃ³n de un registro de sincronizaciÃ³n: inbound (partner â†’ nosotros,
// vÃ­a POST /api/integrations/v1/points) o outbound (nosotros â†’ partner).
enum SyncDirection {
  inbound
  outbound
}

// Evento que disparÃ³ la sincronizaciÃ³n de un punto.
enum SyncEvent {
  point_created
  point_updated
}

// Estado de un job de sincronizaciÃ³n. pending/processing = en cola o en vuelo
// (la cola es la propia tabla: job queue persistente en Postgres con reintentos
// y backoff); delivered = entregado; failed = agotÃ³ los reintentos;
// skipped = descartado sin reintento (p. ej. punto no visible o eco).
enum SyncStatus {
  pending
  processing
  delivered
  failed
  skipped
}

// Partner: otra app de ayuda federada con la nuestra.
//  - `trusted`: si es true, los puntos que nos envÃ­a entran DIRECTO a
//    activo/aprobado; si no, pasan por la cola de moderaciÃ³n como cualquier
//    punto anÃ³nimo (polÃ­tica decidida por el admin al crear el partner).
//  - inbound*: puede enviarnos puntos por API key.
//  - outbound*/sendOn*: reciben nuestros puntos por webhook (broadcast).
//  - Las credenciales outbound (*Enc) se guardan CIFRADAS (AES-256-GCM) con
//    INTEGRATION_ENCRYPTION_KEY; nunca se devuelven en claro por la API.
model Partner {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  contactEmail  String?
  approvedAt    DateTime?
  trusted       Boolean  @default(false)
  inboundEnabled   Boolean @default(true)
  outboundEnabled  Boolean @default(false)
  sendOnCreated    Boolean @default(true)
  sendOnUpdated    Boolean @default(true)
  outboundUrl      String?
  authType         PartnerAuthType @default(api_key)
  outboundHeaderName      String?
  outboundApiKeyValueEnc  String?
  loginUrl                String?
  loginEmailEnc           String?
  loginPasswordEnc        String?
  tokenJsonPath           String?
  tokenHeader             String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  apiKeys   PartnerApiKey[]
  links     PartnerPointLink[]
  syncLogs  PartnerSyncLog[]
  mappings  PartnerMapping[]

  @@index([outboundEnabled])
}

// API key de un partner para llamarnos (inbound). Solo se guarda el hash
// SHA-256 (nunca la clave en claro) + un prefijo para reconocerla en la UI.
// La clave completa se muestra UNA sola vez al emitirla. `revokedAt` la desactiva.
model PartnerApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  partnerId  String    @db.Uuid
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// VÃ­nculo bidireccional partner â†” punto: deduplica el inbound (upsert por
// externalId del partner) y evita bucles en el fan-out (a un partner que ya
// tiene el punto no se le re-envÃ­a como created; los updates excluyen al origen).
model PartnerPointLink {
  id         String   @id @default(uuid()) @db.Uuid
  partnerId  String   @db.Uuid
  pointId    String   @db.Uuid
  externalId String
  createdAt  DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  point   Point   @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([partnerId, externalId])
  @@unique([partnerId, pointId])
  @@index([pointId])
}

// Log append-only de sincronizaciÃ³n Y a la vez job queue del worker outbound:
// cada fila es un intento de entrega con reintentos exponenciales (nextAttemptAt)
// y observabilidad (httpStatus, lastError, deliveredAt). El FK al punto es
// SetNull para que el historial sobreviva al borrado del punto.
model PartnerSyncLog {
  id            String        @id @default(uuid()) @db.Uuid
  partnerId     String        @db.Uuid
  pointId       String?       @db.Uuid
  externalId    String?
  direction     SyncDirection
  event         SyncEvent
  status        SyncStatus    @default(pending)
  attempts      Int           @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  httpStatus    Int?
  deliveredAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  point   Point?  @relation(fields: [pointId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([partnerId, createdAt])
  @@index([pointId])
}

// Mapeo declarativo por partner: define, con expresiones JSONata en las hojas del
// JSON, cómo convertir entre el payload del partner y nuestro sobre canonico.
// El partner lo autogestiona via API key (versionado + dry-run + rollback).
// UNA version activa por (partnerId, direction): la que resuelve MapperRegistry.
model PartnerMapping {
  id         String         @id @default(uuid()) @db.Uuid
  partnerId  String         @db.Uuid
  direction  SyncDirection
  version    Int
  definition Json
  isActive   Boolean        @default(false)
  notes      String?
  createdAt  DateTime       @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, direction, version])
  @@index([partnerId, direction, isActive])
}
