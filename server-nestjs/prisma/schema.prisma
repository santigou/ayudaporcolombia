generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  moderator
}

enum PointType {
  need_help
  offer_help
}

enum PointStatus {
  pending
  active
  resolved
  rejected
  expired
  cancelled
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum PointLocationType {
  location
  origin
  destination
}

enum ContactType {
  phone
  whatsapp
  instagram
  email
  other
}

enum AttachmentType {
  image
  video
  document
}

enum ValidationStatus {
  confirmed
  rejected
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  points            Point[]          @relation("PointCreatedBy")
  validations       Validation[]
  verifications     Verification[]   @relation("VerificationModerator")
  pointUpdates      PointUpdate[]
  moderatorRequests ModeratorRequest[] @relation("RequestByUser")
  reviewedRequests  ModeratorRequest[] @relation("RequestReviewedBy")
}

model ModeratorRequest {
  id           String                 @id @default(cuid())
  userId       String                 @unique
  status       VerificationStatus     @default(pending)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime               @default(now())

  user       User  @relation("RequestByUser", fields: [userId], references: [id])
  reviewedBy User? @relation("RequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
}

model Point {
  id                 String             @id @default(cuid())
  code               String             @unique
  type               PointType
  title              String
  description        String
  helpTypeId         String?
  status             PointStatus        @default(pending)
  verificationStatus VerificationStatus @default(pending)

  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime?

  createdBy User? @relation("PointCreatedBy", fields: [createdById], references: [id])

  helpType      HelpType?        @relation(fields: [helpTypeId], references: [id])
  locations     PointLocation[]
  supplies      PointSupply[]
  contacts      Contact[]
  validations   Validation[]
  verifications Verification[]
  updates       PointUpdate[]
  attachments   Attachment[]

  @@index([type, status])
  @@index([verificationStatus])
  @@index([helpTypeId])
  @@index([createdAt])
  @@index([code])
}

model HelpType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String

  points Point[]
}

model Location {
  id           String   @id @default(cuid())
  city         String
  neighborhood String
  address      String?
  latitude     Float
  longitude    Float

  points PointLocation[]
}

model PointLocation {
  pointId      String
  locationId   String
  locationType PointLocationType

  point    Point    @relation(fields: [pointId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([pointId, locationId, locationType])
  @@index([locationId])
  @@index([locationType])
}

model Supply {
  id   String @id @default(cuid())
  name String @unique

  points PointSupply[]
}

model PointSupply {
  pointId          String
  supplyId         String
  targetQuantity   Decimal?
  receivedQuantity Decimal?
  unit             String?

  point  Point  @relation(fields: [pointId], references: [id], onDelete: Cascade)
  supply Supply @relation(fields: [supplyId], references: [id])

  @@id([pointId, supplyId])
}

model Contact {
  id        String      @id @default(cuid())
  pointId   String
  type      ContactType
  value     String
  isPublic  Boolean     @default(true)

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}

model Validation {
  pointId   String
  userId    String
  status    ValidationStatus @default(confirmed)
  createdAt DateTime         @default(now())

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pointId, userId])
  @@index([status])
}

model Verification {
  id          String             @id @default(cuid())
  pointId     String
  moderatorId String
  status      VerificationStatus
  note        String?
  createdAt   DateTime           @default(now())

  point     Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  moderator User  @relation("VerificationModerator", fields: [moderatorId], references: [id])

  @@index([pointId, createdAt])
  @@index([moderatorId])
}

model PointUpdate {
  id        String   @id @default(cuid())
  pointId   String
  createdById String
  message   String
  createdAt DateTime @default(now())

  point     Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([pointId, createdAt])
}

model Attachment {
  id        String         @id @default(cuid())
  pointId   String
  url       String
  type      AttachmentType
  createdAt DateTime       @default(now())

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}