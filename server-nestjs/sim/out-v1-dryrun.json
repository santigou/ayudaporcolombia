{
  "direction": "outbound",
  "definition": {
    "location": {
      "origin": "$join($map(point.locations[type='origin'], function($l){ $l.address }), ',')",
      "destination": "$join($map(point.locations[type='destination'], function($l){ $l.address }), ',')",
      "city": "point.locations[0].city"
    },
    "description": "point.description",
    "telefono": "point.contacts[0].value",
    "esNuevo": "event = 'point_created' ? true : false"
  },
  "sampleInput": {
    "event": "point_created",
    "point": {
      "description": "Punto de ejemplo para el dry-run",
      "locations": [
        { "type": "origin", "address": "Cra 7 #71-21", "city": "Bogota" },
        { "type": "destination", "address": "Calle 100", "city": "Bogota" }
      ],
      "contacts": [{ "type": "phone", "value": "3001112233" }]
    }
  }
}
