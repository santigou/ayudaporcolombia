# Postgres
DATABASE_URL="postgresql://ayuda:ayuda@localhost:5434/ayudaporcolombia?schema=public"

# Server
PORT=4000
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
CLIENT_ORIGIN="http://localhost:5173"

# Redis: bus de Pub/Sub para el adapter de WebSockets del chat en tiempo real.
# En dev local (sin Docker) apunta al Redis del docker-compose.yml (:6379).
# Si se omite, el backend usa el adaptador de Socket.IO sin Redis (1 solo servidor).
REDIS_URL="redis://localhost:6379"

# Seed del primer moderador (solo se usa una vez, al correr `npm run seed`)
SEED_MODERATOR_NAME="Moderador Principal"
SEED_MODERATOR_EMAIL="moderador@ayudaporcolombia.org"
SEED_MODERATOR_PASSWORD="cambia-esta-clave"

# Storage (subida directa de fotos). El servidor NestJS lee su propio .env
# (server-nestjs/.env); aquí se documentan para consistencia.
# local = disco (dev) | seaweedfs = SeaweedFS vía API S3 (prod)
STORAGE_DRIVER=local
S3_ENDPOINT=https://cdn.jffsolutions.com
S3_REGION=us-east-1
S3_BUCKET=ayudaporcolombia
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://cdn.jffsolutions.com

# Integraciones partner (federación de puntos): ver docs/obsidian/Integraciones partner.md
# Cifra credenciales outbound de partners. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_WORKER_INTERVAL_MS=3000
INTEGRATION_OUTBOUND_TIMEOUT_MS=10000
INTEGRATION_MAX_ATTEMPTS=6
