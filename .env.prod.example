# ===== Postgres =====
POSTGRES_USER=ayuda
POSTGRES_PASSWORD=cambia-por-una-clave-fuerte
POSTGRES_DB=ayudaporcolombia

# ===== App =====
# Secreto largo y aleatorio para firmar los JWT (¡crítico en producción!).
# Ej.: openssl rand -hex 32
JWT_SECRET=
# URL pública del tunnel (p. ej. https://ayuda.tudominio.com). Opcional (same-origin).
CLIENT_ORIGIN=

# Redis: bus de Pub/Sub para el chat en tiempo real (adapter de WebSockets).
# En prod lo define internamente docker-compose.prod.yml (redis://redis:6379);
# no necesitas ponerlo aquí. Si despliegas SIN Docker, apúntalo a tu Redis.
# REDIS_URL=redis://localhost:6379

# ===== Moderador inicial =====
# Se crea SOLO si no existe ese email. Cámbialo tras el primer login.
SEED_MODERATOR_EMAIL=moderador@tudominio.com
SEED_MODERATOR_PASSWORD=cambia-esta-clave-fuerte

# ===== Cloudflare Tunnel (con nombre) =====
# Token del tunnel creado en: Zero Trust → Networks → Tunnels → (tu tunnel) → "Install and run".
# En el mismo tunnel añade un Public Hostname (p. ej. ayuda.tudominio.com) que apunte
# al servicio "http://app:4000".
TUNNEL_TOKEN=

# ===== Storage (fotos) =====
# SeaweedFS vía API S3: el backend genera URLs pre-firmadas (presigned PUT) y el
# navegador sube directo. El backend nunca recibe los bytes.
# La identidad y el bucket anónimo de lectura se definen en el s3.json de
# j4f-storage (ver docs/seaweedfs-s3-config.md).
STORAGE_DRIVER=seaweedfs
S3_ENDPOINT=https://cdn.jffsolutions.com
S3_REGION=us-east-1
S3_BUCKET=ayudaporcolombia
S3_ACCESS_KEY=ayuda_apc_key
S3_SECRET_KEY=
S3_PUBLIC_URL=https://cdn.jffsolutions.com

# ===== Integraciones partner (federación de puntos) =====
# Cifra (AES-256-GCM) las credenciales outbound de los partners. ¡OBLIGATORIA
# antes de configurar cualquier partner con credenciales! Si se cambia después,
# las credenciales guardadas quedarán ilegibles (habría que re-guardarlas).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
# Opcionales (defaults): intervalo del worker (ms), timeout de webhooks (ms),
# nº máximo de intentos por job con backoff exponencial.
# INTEGRATION_WORKER_INTERVAL_MS=3000
# INTEGRATION_OUTBOUND_TIMEOUT_MS=10000
# INTEGRATION_MAX_ATTEMPTS=6
# Mapeos declarativos JSONata (defaults): timeout por evaluación y límite de bytes.
# MAPPING_EVAL_TIMEOUT_MS=2000
# MAPPING_MAX_INPUT_BYTES=262144